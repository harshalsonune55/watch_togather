<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WatchTogether • <%= roomId %></title>
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
</head>
<body style="background-color: var(--bg-app); overflow: hidden;">

  <!-- Virtual Huddle App Layout -->
  <div class="huddle-app-layout">

    <!-- Left Navigation Sidebar (from Virtual Huddle Image 1) -->
    <aside class="huddle-sidebar">
      <!-- Top Brand Logo -->
      <div class="sidebar-header">
        <div class="huddle-cam-icon">
          <i class="fa-solid fa-video"></i>
        </div>
        <div>
          <div class="sidebar-brand-name">WatchTogether</div>
          <div class="sidebar-brand-sub">Web Conferencing</div>
        </div>
      </div>

      <!-- Main Navigation -->
      <div class="sidebar-nav-section">
        <ul class="sidebar-menu-list">
          <li class="sidebar-menu-item active">
            <div class="menu-item-left">
              <i class="fa-solid fa-table-cells-large"></i>
              <span>Dashboard</span>
            </div>
          </li>
          <li class="sidebar-menu-item" id="btnCopyInviteSidebar">
            <div class="menu-item-left">
              <i class="fa-regular fa-clone"></i>
              <span>Copy Invite</span>
            </div>
            <i class="fa-solid fa-link" style="font-size: 0.75rem; color: var(--text-dim);"></i>
          </li>
        </ul>
      </div>

      <!-- SERIES & EPISODES (COURSES in image) -->
      <div class="sidebar-nav-section">
        <div class="sidebar-section-title">SERIES & PLAYLISTS</div>
        <ul class="sidebar-menu-list">
          <% webSeries.forEach(function(s, idx) { %>
            <li class="sidebar-menu-item sidebar-series-select <%= idx === 0 ? 'active' : '' %>" data-series-id="<%= s.id %>">
              <div class="menu-item-left">
                <i class="fa-regular fa-folder"></i>
                <span style="max-width: 130px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= s.title.split(':')[0] %></span>
              </div>
              <span class="menu-badge-red"><%= s.episodes.length %></span>
            </li>
          <% }); %>
        </ul>
      </div>

      <!-- ACTIVITIES -->
      <div class="sidebar-nav-section">
        <div class="sidebar-section-title">ACTIVITIES</div>
        <ul class="sidebar-menu-list">
          <li class="sidebar-menu-item active" style="background: rgba(255, 255, 255, 0.08);">
            <div class="menu-item-left">
              <i class="fa-regular fa-folder-open"></i>
              <span>Theater Stage</span>
            </div>
            <div style="width: 18px; height: 18px; border-radius: 50%; background: var(--blue-action); display: flex; align-items: center; justify-content: center; font-size: 0.55rem; color: white;">●●●</div>
          </li>
          <li class="sidebar-menu-item" id="btnOpenLocalFile">
            <div class="menu-item-left">
              <i class="fa-regular fa-file-video"></i>
              <span>Local File Sync</span>
            </div>
          </li>
        </ul>
      </div>

      <!-- PARTICIPANTS (DIRECT MESSAGES in image) -->
      <div class="sidebar-nav-section">
        <div class="sidebar-section-title">PARTICIPANTS</div>
        <ul class="sidebar-menu-list">
          <li class="sidebar-menu-item">
            <div class="menu-item-left">
              <img class="sidebar-user-avatar" src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=60&q=80" alt="You">
              <span id="sidebarUserName">You (Host)</span>
            </div>
            <i class="fa-solid fa-circle" style="color: var(--mint); font-size: 0.5rem;"></i>
          </li>
          <li class="sidebar-menu-item">
            <div class="menu-item-left">
              <img class="sidebar-user-avatar" src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=60&q=80" alt="Friend">
              <span id="sidebarFriendName">Friend</span>
            </div>
            <i class="fa-solid fa-circle" id="sidebarFriendStatusDot" style="color: var(--text-dim); font-size: 0.5rem;"></i>
          </li>
        </ul>
      </div>

      <!-- Bottom Settings & Help -->
      <div style="margin-top: auto; padding-top: 16px; border-top: 1px solid var(--border-subtle);">
        <ul class="sidebar-menu-list">
          <li class="sidebar-menu-item" id="btnOpenVideoModal">
            <div class="menu-item-left">
              <i class="fa-solid fa-gear"></i>
              <span>Video Settings</span>
            </div>
          </li>
          <li class="sidebar-menu-item" id="btnResyncSidebar">
            <div class="menu-item-left">
              <i class="fa-solid fa-bolt" style="color: var(--mint);"></i>
              <span>Resync Engine</span>
            </div>
          </li>
        </ul>
      </div>
    </aside>

    <!-- Main Conference & Theater View Area -->
    <main class="huddle-main">

      <!-- Top Room Header (from Virtual Huddle Image 1) -->
      <header class="huddle-header">
        <div class="huddle-header-left">
          <h1 class="huddle-room-title" id="stageVideoTitle"><%= video.title || 'Navigating the path to success.' %></h1>
          
          <!-- Participant Avatar Stack (from Virtual Huddle) -->
          <div class="header-avatar-group">
            <img class="header-avatar-circle" src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=60&q=80" alt="p1">
            <img class="header-avatar-circle" src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=60&q=80" alt="p2">
            <img class="header-avatar-circle" src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=60&q=80" alt="p3">
          </div>
        </div>

        <div class="huddle-header-right">
          <!-- Recording / Live In-Sync Pill Button (from Virtual Huddle) -->
          <div class="btn-recording-pill" id="syncStatusBadge">
            <span class="recording-dot"></span>
            <span id="syncStatusText">Live Sync</span>
          </div>

          <!-- User Profile Avatar (from Virtual Huddle) -->
          <img class="header-avatar-circle" style="width: 32px; height: 32px; margin-left: 6px;" src="https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=80&q=80" alt="Profile">
        </div>
      </header>

      <!-- Video Conference Grid (Matching Image 1: 4 Cards) -->
      <div class="huddle-grid-container" id="theaterGrid">

        <!-- Card 1: Main Video Player / Screen Share (Top Left or Large) -->
        <div class="huddle-video-card" id="stageSection" style="grid-column: 1 / 2; grid-row: 1 / 2;">
          <button class="card-options-btn" id="btnCardMenu1" title="Options">•••</button>

          <!-- YouTube Player -->
          <div id="ytPlayerWrapper" style="width: 100%; height: 100%; display: none;">
            <div id="ytPlayer"></div>
          </div>

          <!-- HTML5 Video Player -->
          <video id="html5Player" style="display: none; width: 100%; height: 100%; object-fit: contain;" playsinline></video>

          <!-- Big Play Button Overlay -->
          <div class="play-overlay-btn" id="playOverlayBtn" title="Resume Playback">
            <i class="fa-solid fa-play" style="margin-left: 4px;"></i>
          </div>

          <!-- Autoplay Next Episode Banner -->
          <div class="autoplay-banner" id="autoplayBanner">
            <span>⏭️ Next episode starts in <strong>5s</strong>...</span>
          </div>

          <!-- Screen Share Stage Display (When someone shares their screen) -->
          <div id="screenShareWrapper" class="screen-share-stage-wrapper" style="display: none;">
            <video id="screenSharePlayer" autoplay playsinline style="width: 100%; height: 100%; object-fit: contain; background: #000;"></video>
            <div class="stage-screen-banner">
              <div class="screen-badge">
                <i class="fa-solid fa-desktop" style="color: var(--mint);"></i>
                <span id="screenShareOwner">Screen Share Active</span>
              </div>
              <button id="btnStopStageScreen" class="btn-mint-pill" style="display: none; padding: 4px 12px; font-size: 0.75rem;">
                <i class="fa-solid fa-stop"></i> Stop Sharing
              </button>
            </div>
          </div>

          <!-- Pastel Cyan Title Badge (Bottom Left, from Virtual Huddle) -->
          <div class="pastel-name-pill cyan" id="stageBadge">
            <i class="fa-solid fa-film"></i>
            <span id="stageBadgeText"><%= video.title ? video.title.substring(0, 28) : 'Synchronized Video' %></span>
          </div>
        </div>

        <!-- Card 2: Remote Friend Webcam (Top Right) -->
        <div class="huddle-video-card" id="remoteTile" style="grid-column: 2 / 3; grid-row: 1 / 2;">
          <button class="card-options-btn" title="Options">•••</button>
          
          <video id="remoteVideo" class="huddle-stream-video" autoplay playsinline></video>

          <!-- Illustrated Center Avatar Placeholder (from Virtual Huddle Image 1) -->
          <div class="tile-avatar-placeholder show" id="remotePlaceholder" style="position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; background: #181b24;">
            <div class="huddle-center-avatar lavender">
              <i class="fa-solid fa-user-astronaut"></i>
            </div>
            <div style="font-size: 0.75rem; color: var(--text-dim); margin-top: 10px;">Waiting for friend...</div>
          </div>

          <!-- Pastel Peach Badge (from Virtual Huddle: "Darrell Steward") -->
          <div class="pastel-name-pill peach">
            <i class="fa-solid fa-microphone" id="remoteMicIcon" style="font-size: 0.7rem;"></i>
            <span id="remoteUserName">Darrell Steward</span>
          </div>
        </div>

        <!-- Card 3: Local User Webcam (Bottom Left) -->
        <div class="huddle-video-card" id="localTile" style="grid-column: 1 / 2; grid-row: 2 / 3;">
          <button class="card-options-btn" title="Options">•••</button>

          <video id="localVideo" class="huddle-stream-video" autoplay muted playsinline></video>

          <!-- Illustrated Center Avatar Placeholder (from Virtual Huddle) -->
          <div class="tile-avatar-placeholder" id="localPlaceholder" style="position: absolute; inset: 0; display: none; flex-direction: column; align-items: center; justify-content: center; background: #181b24;">
            <div class="huddle-center-avatar mint">
              <i class="fa-solid fa-user"></i>
            </div>
            <div style="font-size: 0.75rem; color: var(--text-dim); margin-top: 10px;">Camera Off</div>
          </div>

          <!-- Pastel Coral Badge (from Virtual Huddle: "Bessie Cooper") -->
          <div class="pastel-name-pill coral">
            <i class="fa-solid fa-microphone" id="localMicIcon" style="font-size: 0.7rem;"></i>
            <span id="localUserName">Bessie Cooper (You)</span>
          </div>
        </div>

        <!-- Card 4: Web Series Episodes & Playback Queue (Bottom Right) -->
        <div class="huddle-video-card" id="queueTile" style="grid-column: 2 / 3; grid-row: 2 / 3; padding: 24px; display: flex; flex-direction: column; align-items: stretch; justify-content: flex-start; overflow-y: auto;">
          <button class="card-options-btn" id="btnOpenEpModal" title="Series">•••</button>

          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px;">
            <div style="font-size: 0.85rem; font-weight: 800; color: white;">EPISODES & PLAYLIST</div>
            <span id="currentEpisodePill" style="font-size: 0.72rem; color: var(--mint); font-weight: 700;">Episode 1</span>
          </div>

          <!-- Episode quick list items inside card -->
          <div class="episodes-list" id="episodesListContainer" style="max-height: 180px; overflow-y: auto;"></div>

          <!-- Pastel Mint Badge (from Virtual Huddle: "Esther Howard") -->
          <div class="pastel-name-pill mint">
            <i class="fa-solid fa-clapperboard"></i>
            <span>Esther Howard (Series Queue)</span>
          </div>
        </div>

      </div>

      <!-- Floating Bottom Control Dock (Exact match of Virtual Huddle Image 1) -->
      <div class="huddle-bottom-dock-wrapper">
        
        <!-- Main Controls Dock Pill -->
        <div class="huddle-dock">
          <!-- Hamburger / Drawer Button -->
          <button class="dock-circle-btn" id="btnToggleSidebar" title="Toggle Navigation">
            <i class="fa-solid fa-bars"></i>
          </button>

          <!-- Microphone Toggle Button -->
          <button class="dock-circle-btn" id="btnToggleMic" title="Mute/Unmute Mic">
            <i class="fa-solid fa-microphone"></i>
          </button>

          <!-- Camera Toggle Button -->
          <button class="dock-circle-btn" id="btnToggleCam" title="Turn Camera On/Off">
            <i class="fa-solid fa-video"></i>
          </button>

          <!-- Screen Share Button -->
          <button class="dock-circle-btn" id="btnShareScreen" title="Share Screen in Theater">
            <i class="fa-solid fa-arrow-up-from-bracket"></i>
          </button>

          <!-- Resync / Options Button -->
          <button class="dock-circle-btn" id="btnResync" title="Force Resync">
            <i class="fa-solid fa-ellipsis"></i>
          </button>

          <!-- Play / Pause Button -->
          <button class="dock-circle-btn" id="btnPlayPause" title="Play/Pause">
            <i class="fa-solid fa-play" id="playIcon"></i>
          </button>

          <!-- Red End Call Button (from Virtual Huddle) -->
          <button class="dock-end-call-btn" id="btnLeaveRoom" title="Leave Call" onclick="window.location.href='/'">
            <i class="fa-solid fa-phone-slash"></i>
          </button>
        </div>

        <!-- Chat & Reactions Dock Pill (Bottom Right in Virtual Huddle) -->
        <div class="huddle-side-dock">
          <button class="dock-circle-btn" id="btnToggleChat" title="Chat">
            <i class="fa-regular fa-message"></i>
          </button>
          <button class="dock-circle-btn" id="btnOpenReactions" title="Emoji Burst">
            <i class="fa-regular fa-face-smile"></i>
          </button>
        </div>

      </div>

      <!-- Timeline Scrubber Mini Dock (Floats over stage when scrubbing) -->
      <div style="position: absolute; bottom: 84px; left: 50%; transform: translateX(-50%); width: min(650px, 90vw); z-index: 90;">
        <div style="display: flex; align-items: center; gap: 10px; background: rgba(18, 20, 27, 0.85); backdrop-filter: blur(16px); padding: 6px 16px; border-radius: var(--radius-full); border: 1px solid var(--border-subtle);">
          <span class="time-readout" id="timeCurrent" style="font-size: 0.75rem; color: var(--text-dim); font-family: monospace;">00:00</span>
          
          <div class="timeline-progress-bar" id="timelineProgress" style="flex: 1; height: 5px; background: rgba(255, 255, 255, 0.1); border-radius: 3px; cursor: pointer; position: relative;">
            <div class="timeline-current" id="timelineCurrent" style="height: 100%; width: 0%; background: var(--mint); border-radius: 3px;"></div>
          </div>

          <span class="time-readout" id="timeDuration" style="font-size: 0.75rem; color: var(--text-dim); font-family: monospace;">00:00</span>
          
          <!-- Speed -->
          <select class="speed-select" id="speedSelect" style="background: transparent; border: none; color: white; font-size: 0.75rem; font-weight: 700; cursor: pointer; outline: none;">
            <option value="0.5">0.5x</option>
            <option value="1.0" selected>1.0x</option>
            <option value="1.25">1.25x</option>
            <option value="1.5">1.5x</option>
            <option value="2.0">2.0x</option>
          </select>
        </div>
      </div>

    </main>

  </div>

  <!-- Slide-Out Chat Drawer (Clean UI) -->
  <aside class="huddle-chat-drawer" id="chatDrawer">
    <div class="chat-drawer-header">
      <div style="font-weight: 800; color: white; font-size: 1rem;"><i class="fa-regular fa-message" style="margin-right: 8px; color: var(--mint);"></i>Room Chat</div>
      <button class="btn-close-drawer" id="btnCloseChatDrawer">✕</button>
    </div>

    <!-- Messages List -->
    <div class="messages-list" id="messagesList" style="flex: 1; padding: 16px; overflow-y: auto; display: flex; flex-direction: column; gap: 10px;"></div>

    <!-- Typing Indicator -->
    <div class="typing-indicator" id="typingIndicator" style="padding: 4px 16px; font-size: 0.75rem; color: var(--text-dim);"></div>

    <!-- Floating Emoji Reaction Bar -->
    <div class="emoji-bar" style="padding: 8px 14px; border-top: 1px solid var(--border-subtle); display: flex; justify-content: space-around;">
      <button class="btn-emoji" data-emoji="❤️" style="background: none; border: none; font-size: 1.25rem; cursor: pointer;">❤️</button>
      <button class="btn-emoji" data-emoji="🔥" style="background: none; border: none; font-size: 1.25rem; cursor: pointer;">🔥</button>
      <button class="btn-emoji" data-emoji="😂" style="background: none; border: none; font-size: 1.25rem; cursor: pointer;">😂</button>
      <button class="btn-emoji" data-emoji="🍿" style="background: none; border: none; font-size: 1.25rem; cursor: pointer;">🍿</button>
      <button class="btn-emoji" data-emoji="👏" style="background: none; border: none; font-size: 1.25rem; cursor: pointer;">👏</button>
      <button class="btn-emoji" data-emoji="🚀" style="background: none; border: none; font-size: 1.25rem; cursor: pointer;">🚀</button>
    </div>

    <!-- Chat Input -->
    <div style="padding: 12px 16px; border-top: 1px solid var(--border-subtle); display: flex; gap: 8px;">
      <input type="text" id="chatInput" class="clean-input-box" placeholder="Type a message..." style="margin-bottom: 0; padding: 10px 14px; font-size: 0.85rem;" autocomplete="off">
      <button id="btnSendChat" class="btn-mint-pill" style="padding: 10px 14px; font-size: 0.85rem;">
        <i class="fa-solid fa-paper-plane"></i>
      </button>
    </div>
  </aside>

  <!-- Video Settings / Change Link Modal -->
  <div class="modal-backdrop" id="videoModal">
    <div class="modal-dialog">
      <div class="modal-header">
        <h3 class="modal-title">Load Video / Series</h3>
        <button class="btn-close-drawer" id="btnCloseModal">✕</button>
      </div>

      <form id="formLoadVideo">
        <label class="input-label-clean" for="inputVideoUrl">Video URL (YouTube or Direct MP4 / Web Stream)</label>
        <input type="text" id="inputVideoUrl" class="clean-input-box" placeholder="Paste YouTube link or direct video file URL" required>

        <button type="submit" class="btn-mint-pill" style="width: 100%; padding: 12px; margin-top: 6px;">
          <span>↗ Load & Sync with Partner</span>
        </button>
      </form>

      <!-- Instant Samples -->
      <div style="font-size: 0.8rem; font-weight: 700; color: var(--text-dim); text-transform: uppercase; margin: 20px 0 10px;">Quick Demos</div>
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
        <% sampleVideos.forEach(function(vid) { %>
          <div class="sample-card modal-sample-card" data-source="<%= vid.source %>" data-title="<%= vid.title %>" data-type="<%= vid.type %>" style="border-radius: var(--radius-sm); padding: 10px; background: var(--bg-card); cursor: pointer;">
            <div style="font-size: 0.65rem; color: var(--mint); font-weight: 700;"><%= vid.badge %></div>
            <div style="font-size: 0.8rem; font-weight: 600; color: white;"><%= vid.title %></div>
          </div>
        <% }); %>
      </div>
    </div>
  </div>

  <!-- Local Video File Input (Hidden) -->
  <input type="file" id="inputLocalFile" accept="video/mp4,video/webm,video/mkv" style="display: none;">

  <!-- Toast Notice -->
  <div class="toast-notice" id="toastNotice"></div>

  <!-- Runtime Config -->
  <script>
    window.ROOM_CONFIG = {
      roomId: "<%= roomId %>",
      userName: "<%= initialUserName %>"
    };
  </script>

  <!-- External Libraries -->
  <script src="https://www.youtube.com/iframe_api"></script>
  <script src="/socket.io/socket.io.js"></script>

  <!-- Watch Together Modular Engines -->
  <script src="/js/sync-engine.js"></script>
  <script src="/js/webrtc-call.js"></script>
  <script src="/js/chat-engine.js"></script>
  <script src="/js/room.js"></script>

  <script>
    // Chat Drawer Toggle
    const btnToggleChat = document.getElementById('btnToggleChat');
    const btnCloseChatDrawer = document.getElementById('btnCloseChatDrawer');
    const chatDrawer = document.getElementById('chatDrawer');

    if (btnToggleChat && chatDrawer) {
      btnToggleChat.addEventListener('click', () => {
        chatDrawer.classList.toggle('open');
      });
    }
    if (btnCloseChatDrawer && chatDrawer) {
      btnCloseChatDrawer.addEventListener('click', () => {
        chatDrawer.classList.remove('open');
      });
    }

    // Toggle Left Sidebar
    const btnToggleSidebar = document.getElementById('btnToggleSidebar');
    const sidebar = document.querySelector('.huddle-sidebar');
    if (btnToggleSidebar && sidebar) {
      btnToggleSidebar.addEventListener('click', () => {
        sidebar.style.display = sidebar.style.display === 'none' ? 'flex' : 'none';
      });
    }

    // Local File Picker Trigger
    const btnOpenLocalFile = document.getElementById('btnOpenLocalFile');
    const inputLocalFile = document.getElementById('inputLocalFile');
    if (btnOpenLocalFile && inputLocalFile) {
      btnOpenLocalFile.addEventListener('click', () => {
        inputLocalFile.click();
      });
    }

    // Copy Invite in Sidebar
    const btnCopyInviteSidebar = document.getElementById('btnCopyInviteSidebar');
    if (btnCopyInviteSidebar) {
      btnCopyInviteSidebar.addEventListener('click', () => {
        navigator.clipboard.writeText(window.location.href);
        const toast = document.getElementById('toastNotice');
        if (toast) {
          toast.textContent = "📋 Invite link copied to clipboard!";
          toast.classList.add('show');
          setTimeout(() => toast.classList.remove('show'), 2500);
        }
      });
    }
  </script>
</body>
</html>
