<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Watchooo • Transform How You Watch Together</title>
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
</head>
<body class="finsage-app">

  <!-- FinSage Top Navigation Bar -->
  <nav class="finsage-nav">
    <a href="/" class="finsage-brand">
      <img src="/images/logo.png" alt="Watchooo Logo" class="brand-logo-img">
      <span>Watchooo</span>
    </a>

    <div class="finsage-nav-links">
      <a href="#about" class="finsage-nav-link active">About us</a>
      <a href="#joinForm" class="finsage-nav-link">Direct Link</a>
      <a href="#joinForm" class="finsage-nav-link">Screen Share</a>
      <a href="#howToUse" class="finsage-nav-link">How to Use</a>
    </div>

    <a href="#joinForm" class="btn-mint-pill">
      <i class="fa-solid fa-door-open"></i>
      <span>Enter Theater</span>
    </a>
  </nav>

  <!-- Hero Section -->
  <main class="finsage-hero">
    <div class="hero-tag-pill">
      <span class="hero-tag-dot"></span>
      <span>Zero-drift synchronization & HD Video Call</span>
    </div>

    <div class="hero-columns">
      <h1 class="hero-big-title">
        Transform how<br>you watch together
      </h1>

      <div class="hero-right-side">
        <p class="hero-description">
          Paste any YouTube or direct video link to synchronize playback with zero drift, or share your screen directly in theater mode while enjoying a crystal-clear 2-way video call.
        </p>
        <div class="hero-actions">
          <a href="#joinForm" class="btn-mint-pill" style="padding: 12px 24px;">
            <i class="fa-solid fa-door-open"></i>
            <span>Enter Theater</span>
          </a>
          <a href="#joinForm" class="btn-glass-pill" style="padding: 12px 24px;">
            <span>Direct Link or Screen Share ▷</span>
          </a>
        </div>
      </div>
    </div>

    <!-- FinSage Bento Showcase Card Container -->
    <div class="finsage-bento-container">
      
      <!-- Left Column: Metrics & Vertical Bar Graph (from FinSage) -->
      <div class="bento-left-col">
        <!-- Customer Stack -->
        <div class="user-stack-row">
          <div class="avatar-stack">
            <img class="avatar-stack-item" src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100&q=80" alt="Viewer">
            <img class="avatar-stack-item" src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=100&q=80" alt="Viewer">
            <img class="avatar-stack-item" src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=100&q=80" alt="Viewer">
            <img class="avatar-stack-item" src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=100&q=80" alt="Viewer">
          </div>
          <div>
            <div class="avatar-stack-label">+150K</div>
            <div class="avatar-stack-sub">active watch parties</div>
          </div>
        </div>

        <!-- Metric Card with Rounded Bar Graph -->
        <div class="bento-metric-card">
          <div class="card-top-action">↗</div>
          <div class="metric-caption">More in-sync and seamless</div>
          <div class="metric-val-row">
            <div class="metric-big-num">99.8%</div>
            <div class="metric-badge-pill">↑ 0.02s drift</div>
          </div>

          <!-- Rounded Vertical Bar Graph matching FinSage -->
          <div class="bar-chart-container">
            <div class="bar-col" style="height: 35%;"></div>
            <div class="bar-col fill-white" style="height: 60%;"></div>
            <div class="bar-col" style="height: 45%;"></div>
            <div class="bar-col fill-white" style="height: 80%;"></div>
            <div class="bar-col" style="height: 55%;"></div>
            <div class="bar-col fill-white" style="height: 92%;"></div>
            <div class="bar-col" style="height: 70%;"></div>
            <div class="bar-col fill-white" style="height: 100%;"></div>
          </div>
        </div>

        <!-- Floating Metric Card 2 -->
        <div class="floating-white-card dark">
          <div class="floating-card-title">HD WebRTC Video Call</div>
          <div class="floating-card-val" style="color: var(--mint);">2-Way Realtime</div>
          <div style="font-size: 0.72rem; color: var(--text-dim); margin-top: 4px;">Speaking aura, screen share & mic mute</div>
        </div>
      </div>

      <!-- Right Column: Interactive Room Creator & Floating Wave Card -->
      <div class="bento-right-col" id="joinForm">
        <div class="bento-ambient-glow"></div>

        <div>
          <h2 class="bento-form-title">Enter Your Watch Party</h2>
          <p class="bento-form-sub">Provide your direct video link (YouTube / MP4) or enter the room to share your screen directly.</p>

          <form action="/video" method="POST">
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px;">
              <div>
                <label class="input-label-clean" for="displayName">Your Display Name</label>
                <input type="text" id="displayName" name="displayName" class="clean-input-box" placeholder="e.g. Alex" required>
              </div>

              <div>
                <label class="input-label-clean" for="roomId">Room Code</label>
                <input type="text" id="roomId" name="roomId" class="clean-input-box" placeholder="e.g. cinema-lounge">
              </div>
            </div>

            <div style="margin-bottom: 20px;">
              <label class="input-label-clean" for="videoLink">Direct Video Link (Optional)</label>
              <input type="text" id="videoLink" name="videoLink" class="clean-input-box" placeholder="Paste YouTube link or direct MP4 stream (leave blank to share screen)">
              <div style="display: flex; gap: 12px; margin-top: 6px; font-size: 0.75rem; color: var(--text-dim);">
                <span><i class="fa-solid fa-link" style="color: var(--mint); margin-right: 4px;"></i> Direct URL Sync</span>
                <span><i class="fa-solid fa-desktop" style="color: var(--mint); margin-right: 4px;"></i> 1-Click Screen Share in Room</span>
              </div>
            </div>

            <div style="display: flex; gap: 12px;">
              <button type="submit" class="btn-mint-pill" style="flex: 1; padding: 14px; font-size: 0.95rem;">
                <i class="fa-solid fa-door-open"></i>
                <span>Enter Theater</span>
              </button>
              <button type="button" class="btn-glass-pill" onclick="generateRandomRoom()" title="Generate Random Room">
                <i class="fa-solid fa-shuffle"></i>
              </button>
            </div>
          </form>
        </div>

        <!-- Floating White Cards matching FinSage -->
        <div class="floating-showcase-row">
          <!-- Floating White Card with Wave Line Chart -->
          <div class="floating-white-card">
            <div style="display: flex; align-items: center; justify-content: space-between;">
              <div class="floating-card-title">Playback Lock</div>
              <span style="font-size: 0.7rem; font-weight: 700; color: #16a34a;">● Locked</span>
            </div>
            <div class="floating-card-val">99.9%</div>
            <!-- Smooth Green Wave SVG matching FinSage -->
            <svg viewBox="0 0 100 24" style="width: 100%; height: 32px; margin-top: 4px;">
              <path d="M0,18 Q15,4 30,14 T60,8 T80,16 T100,6" fill="none" stroke="#22c55e" stroke-width="2.5" stroke-linecap="round"/>
              <path d="M0,18 Q15,4 30,14 T60,8 T80,16 T100,6 L100,24 L0,24 Z" fill="rgba(34,197,94,0.12)"/>
            </svg>
          </div>

          <!-- Floating White Card with Active Stream Stat -->
          <div class="floating-white-card">
            <div style="display: flex; align-items: center; justify-content: space-between;">
              <div class="floating-card-title">Screen Share Mode</div>
              <div style="width: 20px; height: 20px; border-radius: 50%; background: #0c0d11; color: white; display: flex; align-items: center; justify-content: center; font-size: 0.65rem;">↗</div>
            </div>
            <div class="floating-card-val">Full HD Stage</div>
            <div style="margin-top: 10px; height: 6px; background: #e2e8f0; border-radius: 3px; overflow: hidden;">
              <div style="height: 100%; width: 75%; background: #0c0d11; border-radius: 3px;"></div>
            </div>
          </div>
        </div>

      </div>

    </div>

    <!-- How to Use Section -->
    <section id="howToUse" class="how-to-use">
      <div class="how-to-use-inner">
        <h2 class="how-to-use-title">How to Use</h2>
        <div class="how-to-steps">
          <div class="how-to-step">
            <span class="step-badge">1</span>
            <h3>Enter Name &amp; Link</h3>
            <p>Type your name, paste a <strong>YouTube / MP4</strong> link, and click <strong>↗ Enter Synchronized Theater</strong> to launch your room.</p>
          </div>
          <div class="how-to-step">
            <span class="step-badge">2</span>
            <h3>Get Invite Link</h3>
            <p>Click <strong>Copy Invite</strong> in the sidebar and share the link — your friend joins with <strong>zero-drift sync</strong> automatically.</p>
          </div>
          <div class="how-to-step">
            <span class="step-badge">3</span>
            <h3>Watch &amp; Talk</h3>
            <p>Click <strong>Play/Pause</strong>, turn on <strong>HD cam + mic</strong>, hit <strong>Screen Share</strong> to broadcast into the theater, and use <strong>live chat + emoji reactions</strong>.</p>
          </div>
        </div>
      </div>
    </section>

  </main>

  <style>
    .how-to-use {
      width: 100%;
      max-width: 1380px;
      margin: 0 auto;
      padding: 60px 0;
      background: transparent;
      color: #fff;
    }
    .how-to-use-inner {
      width: 100%;
      max-width: none;
      margin: 0;
    }
    .how-to-use-title {
      text-align: center;
      font-size: 2rem;
      margin-bottom: 40px;
      font-weight: 800;
      letter-spacing: -0.5px;
    }
    .how-to-steps {
      display: flex;
      gap: 20px;
      flex-wrap: wrap;
      justify-content: space-between;
    }
    .how-to-step {
      background: var(--bg-surface);
      border: 1px solid var(--border-card);
      border-radius: 16px;
      padding: 28px 24px;
      flex: 1 1 300px;
      text-align: left;
      transition: transform 0.2s, border-color 0.2s;
    }
    .how-to-step:hover {
      transform: translateY(-4px);
      border-color: var(--border-hover);
    }
    .step-badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 34px;
      height: 34px;
      background: var(--mint);
      color: #0c0d11;
      border-radius: 50%;
      font-weight: 900;
      font-size: 1.1rem;
      margin-bottom: 14px;
    }
    .how-to-step h3 {
      margin: 0 0 10px;
      font-size: 1.15rem;
      font-weight: 700;
      color: #fbbf24;
    }
    .how-to-step p {
      margin: 0;
      font-size: 0.92rem;
      color: var(--text-muted);
      line-height: 1.6;
    }
    .how-to-step strong {
      color: #fff;
      font-weight: 700;
    }
  </style>

  <script>
    const nameInput = document.getElementById('displayName');
    const savedName = localStorage.getItem('wt_username');
    if (savedName) {
      nameInput.value = savedName;
    } else {
      nameInput.value = "Alex";
    }

    nameInput.addEventListener('input', () => {
      localStorage.setItem('wt_username', nameInput.value.trim());
    });

    const roomInput = document.getElementById('roomId');
    if (roomInput) {
      roomInput.addEventListener('input', () => {
        let val = roomInput.value.trim();
        if (val.includes('/room/')) {
          val = val.split('/room/')[1].split('?')[0].split('#')[0].trim();
          roomInput.value = val;
        }
      });
    }

    function selectSampleVideo(url, cardEl) {
      document.getElementById('videoLink').value = url;
      document.querySelectorAll('.sample-card').forEach(c => c.classList.remove('active'));
      cardEl.classList.add('active');
    }

    function generateRandomRoom() {
      const adjectives = ["cosmic", "neon", "velvet", "stellar", "cinema", "midnight", "crystal", "cyber"];
      const nouns = ["wave", "theater", "lounge", "stream", "orbit", "spark", "echo", "pulse"];
      const randAdj = adjectives[Math.floor(Math.random() * adjectives.length)];
      const randNoun = nouns[Math.floor(Math.random() * nouns.length)];
      const randNum = Math.floor(Math.random() * 899 + 100);
      document.getElementById('roomId').value = `${randAdj}-${randNoun}-${randNum}`;
    }
  </script>
</body>
</html>
