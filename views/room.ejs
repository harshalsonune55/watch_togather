<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Watchooo • <%= roomId %></title>
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
</head>
<body style="background-color: var(--bg-app); overflow: hidden;">

  <!-- Virtual Huddle App Layout -->
  <div class="huddle-app-layout">

    <!-- Left Navigation Sidebar (from Virtual Huddle Image 1) -->
    <aside class="huddle-sidebar">
      <!-- Top Brand Logo -->
      <a href="/" class="sidebar-header" style="text-decoration: none;">
        <img src="/images/logo.png" alt="Watchooo Logo" class="sidebar-logo-img">
        <div>
          <div class="sidebar-brand-name">Watchooo</div>
          <div class="sidebar-brand-sub">Watch Together</div>
        </div>
      </a>

      <!-- Main Navigation -->
      <div class="sidebar-nav-section">
        <ul class="sidebar-menu-list">
          <li class="sidebar-menu-item active">
            <div class="menu-item-left">
              <i class="fa-solid fa-table-cells-large"></i>
              <span>Dashboard</span>
            </div>
          </li>
          <li class="sidebar-menu-item" id="btnCopyInviteSidebar">
            <div class="menu-item-left">
              <i class="fa-regular fa-clone"></i>
              <span>Copy Invite</span>
            </div>
            <i class="fa-solid fa-link" style="font-size: 0.75rem; color: var(--text-dim);"></i>
          </li>
        </ul>
      </div>

      <!-- PLAYBACK SOURCES -->
      <div class="sidebar-nav-section">
        <div class="sidebar-section-title">PLAYBACK SOURCES</div>
        <ul class="sidebar-menu-list">
          <li class="sidebar-menu-item active" id="btnSidebarDirectLink">
            <div class="menu-item-left">
              <i class="fa-solid fa-link"></i>
              <span>Direct Link</span>
            </div>
            <i class="fa-solid fa-arrow-up-right-from-square" style="font-size: 0.7rem; color: var(--mint);"></i>
          </li>
          <li class="sidebar-menu-item" id="btnSidebarScreenShare">
            <div class="menu-item-left">
              <i class="fa-solid fa-desktop"></i>
              <span>Screen Share</span>
            </div>
            <span class="menu-badge-red" style="background: var(--mint); color: #0c0d11; font-weight: 800;">LIVE</span>
          </li>
          <li class="sidebar-menu-item" id="btnOpenLocalFile">
            <div class="menu-item-left">
              <i class="fa-regular fa-file-video"></i>
              <span>Local File</span>
            </div>
          </li>
        </ul>
      </div>

      <!-- ACTIVITIES -->
      <div class="sidebar-nav-section">
        <div class="sidebar-section-title">ACTIVITIES</div>
        <ul class="sidebar-menu-list">
          <li class="sidebar-menu-item active" style="background: rgba(255, 255, 255, 0.08);">
            <div class="menu-item-left">
              <i class="fa-regular fa-folder-open"></i>
              <span>Theater Stage</span>
            </div>
            <div style="width: 18px; height: 18px; border-radius: 50%; background: var(--blue-action); display: flex; align-items: center; justify-content: center; font-size: 0.55rem; color: white;">●●●</div>
          </li>
          <li class="sidebar-menu-item" id="btnOpenLocalFile">
            <div class="menu-item-left">
              <i class="fa-regular fa-file-video"></i>
              <span>Local File Sync</span>
            </div>
          </li>
        </ul>
      </div>

      <!-- PARTICIPANTS (DIRECT MESSAGES in image) -->
      <div class="sidebar-nav-section">
        <div class="sidebar-section-title">PARTICIPANTS</div>
        <ul class="sidebar-menu-list">
          <li class="sidebar-menu-item">
            <div class="menu-item-left">
              <img class="sidebar-user-avatar" src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=60&q=80" alt="You">
              <span id="sidebarUserName">You (Host)</span>
            </div>
            <i class="fa-solid fa-circle" style="color: var(--mint); font-size: 0.5rem;"></i>
          </li>
          <li class="sidebar-menu-item">
            <div class="menu-item-left">
              <img class="sidebar-user-avatar" src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=60&q=80" alt="Friend">
              <span id="sidebarFriendName">Friend</span>
            </div>
            <i class="fa-solid fa-circle" id="sidebarFriendStatusDot" style="color: var(--text-dim); font-size: 0.5rem;"></i>
          </li>
        </ul>
      </div>

      <!-- Invite Friends Button -->
      <button id="btnOpenShareModal" class="btn btn-primary" style="padding: 6px 12px; font-size: 0.82rem;" title="Invite & Share Room">
        <i class="fa-solid fa-user-plus"></i> Invite
      </button>

      <!-- Web Series & Episodes Drawer Button -->
      <button id="btnOpenSeries" class="btn btn-secondary" style="padding: 6px 12px; font-size: 0.82rem;" title="Browse Web Series & Episodes">
        <i class="fa-solid fa-list-ol"></i> Episodes
      </button>

    <!-- Main Conference & Theater View Area -->
    <main class="huddle-main">

      <!-- Top Room Header (from Virtual Huddle Image 1) -->
      <header class="huddle-header">
        <div class="huddle-header-left">
          <h1 class="huddle-room-title" id="stageVideoTitle"><%= video.title || 'Navigating the path to success.' %></h1>
          
          <!-- Participant Avatar Stack (from Virtual Huddle) -->
          <div class="header-avatar-group">
            <img class="header-avatar-circle" src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=60&q=80" alt="p1">
            <img class="header-avatar-circle" src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=60&q=80" alt="p2">
            <img class="header-avatar-circle" src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=60&q=80" alt="p3">
          </div>
        </div>

        <div class="huddle-header-right">
          <!-- Theater / Cinema View Toggle -->
          <button class="btn-cinema-toggle" id="btnToggleCinema" title="Toggle Fullstage Cinema Mode">
            <i class="fa-solid fa-expand" id="cinemaToggleIcon"></i>
            <span id="cinemaToggleText">Cinema View</span>
          </button>

          <!-- Recording / Live In-Sync Pill Button (from Virtual Huddle) -->
          <div class="btn-recording-pill" id="syncStatusBadge">
            <span class="recording-dot"></span>
            <span id="syncStatusText">Live Sync</span>
          </div>

          <!-- User Profile Avatar (from Virtual Huddle) -->
          <img class="header-avatar-circle" style="width: 32px; height: 32px; margin-left: 6px;" src="https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=80&q=80" alt="Profile">
        </div>
      </header>

      <!-- Video Conference & Theater Grid (Big Stage Window + Small Profile Windows) -->
      <div class="huddle-grid-container theater-layout" id="theaterGrid">

        <!-- BIG WINDOW: Main Video Stage / Movie Screen & Presenting Screen Share -->
        <div class="huddle-video-card huddle-stage-card" id="stageSection">
          
          <!-- Stage Top Actions (Cinema / Theater Expand / Video Settings) -->
          <div class="stage-top-actions">
            <button class="stage-action-pill" id="btnStageExpand" title="Toggle Cinema View">
              <i class="fa-solid fa-expand" id="stageExpandIcon"></i>
              <span id="stageExpandText">Cinema Mode</span>
            </button>
            <button class="card-options-btn" id="btnCardMenu1" title="Video Settings">•••</button>
          </div>

          <!-- YouTube Player Wrapper -->
          <div id="ytPlayerWrapper" class="stage-media-wrapper" style="display: none;">
            <div id="ytPlayer"></div>
          </div>

          <!-- HTML5 Video Player -->
          <video id="html5Player" class="stage-media-wrapper stage-html5-video" style="display: none;" playsinline></video>

          <!-- Big Play Button Overlay -->
          <div class="play-overlay-btn" id="playOverlayBtn" title="Resume Playback">
            <i class="fa-solid fa-play" style="margin-left: 4px;"></i>
          </div>

          <!-- Standby Empty State (When no direct link is loaded yet) -->
          <div id="stageEmptyState" class="stage-empty-state" style="<%= (video && video.source) ? 'display: none;' : 'display: flex;' %>">
            <div class="empty-state-icon">
              <i class="fa-solid fa-film"></i>
            </div>
            <h2 class="empty-state-title">Synchronized Theater Ready</h2>
            <p class="empty-state-desc">Paste any YouTube URL or direct MP4 stream to watch in sync, or share your screen directly on stage.</p>
            <div class="empty-state-actions">
              <button class="btn-mint-pill" id="btnEmptyLoadLink" type="button">
                <i class="fa-solid fa-link"></i>
                <span>Paste Video Link</span>
              </button>
              <button class="btn-glass-pill" id="btnEmptyShareScreen" type="button">
                <i class="fa-solid fa-arrow-up-from-bracket"></i>
                <span>Share Screen</span>
              </button>
            </div>
          </div>

          <!-- Screen Share Stage Display (When someone shares their screen) -->
          <div id="screenShareWrapper" class="screen-share-stage-wrapper" style="display: none;">
            <video id="screenSharePlayer" autoplay playsinline class="screen-share-stage-video"></video>
            <div class="stage-screen-banner">
              <div class="screen-badge">
                <i class="fa-solid fa-desktop" style="color: var(--mint);"></i>
                <span id="screenShareOwner">Screen Share Active</span>
              </div>
              <button id="btnStopStageScreen" class="btn-mint-pill" style="display: none; padding: 4px 12px; font-size: 0.75rem;">
                <i class="fa-solid fa-stop"></i> Stop Sharing
              </button>
            </div>
          </div>

          <!-- Pastel Cyan Title Badge (Bottom Left, from Virtual Huddle) -->
          <div class="pastel-name-pill cyan" id="stageBadge">
            <i class="fa-solid fa-film"></i>
            <span id="stageBadgeText"><%= video.title ? video.title.substring(0, 28) : 'Synchronized Video' %></span>
          </div>
        </div>

        <!-- SMALL WINDOWS: Dedicated Side Column for User Profiles & Live Chat -->
        <div class="huddle-side-column" id="sideProfilesColumn">

          <!-- Small Window 1: Remote Friend Webcam & Profile -->
          <div class="huddle-video-card huddle-profile-small-card" id="remoteTile">
            <!-- Animated Moving Dots on Speaking -->
            <div class="card-dots-badge" id="remoteDotsBadge" title="Speaking Activity">
              <span class="speaking-dot d1"></span>
              <span class="speaking-dot d2"></span>
              <span class="speaking-dot d3"></span>
            </div>
            
            <video id="remoteVideo" class="huddle-stream-video" autoplay muted playsinline></video>
            <audio id="remoteAudio" autoplay playsinline></audio>

            <!-- Illustrated Center Avatar Placeholder -->
            <div class="tile-avatar-placeholder show" id="remotePlaceholder">
              <div class="huddle-center-avatar lavender">
                <i class="fa-solid fa-user-astronaut"></i>
              </div>
              <div class="tile-placeholder-text" id="remotePlaceholderText">Waiting for friend...</div>
            </div>

            <!-- Pastel Peach Badge: Remote User Profile -->
            <div class="pastel-name-pill peach small-badge">
              <i class="fa-solid fa-microphone" id="remoteMicIcon"></i>
              <span id="remoteUserName">Waiting for friend...</span>
            </div>
          </div>

          <!-- Small Window 2: Local User Webcam & Profile (You) -->
          <div class="huddle-video-card huddle-profile-small-card" id="localTile">
            <!-- Animated Moving Dots on Speaking -->
            <div class="card-dots-badge" id="localDotsBadge" title="Speaking Activity">
              <span class="speaking-dot d1"></span>
              <span class="speaking-dot d2"></span>
              <span class="speaking-dot d3"></span>
            </div>

            <video id="localVideo" class="huddle-stream-video" autoplay muted playsinline></video>

            <!-- Illustrated Center Avatar Placeholder -->
            <div class="tile-avatar-placeholder" id="localPlaceholder">
              <div class="huddle-center-avatar mint">
                <i class="fa-solid fa-user"></i>
              </div>
              <div class="tile-placeholder-text">Camera Off</div>
            </div>

            <!-- Pastel Coral Badge: Local User Profile -->
            <div class="pastel-name-pill coral small-badge">
              <i class="fa-solid fa-microphone" id="localMicIcon"></i>
              <span id="localUserName"><%= initialUserName ? initialUserName + ' (You)' : 'You' %></span>
            </div>
          </div>

          <input type="file" id="inputLocalFile" accept="video/mp4,video/webm,video/ogg,video/mkv" style="display: none;">

          <!-- Small Window 3: Live In-Room Chat Section -->
          <div class="huddle-video-card huddle-chat-inline-card" id="chatCardTile">
            <!-- Chat Header -->
            <div class="chat-inline-header">
              <div class="chat-header-left">
                <i class="fa-regular fa-message" style="color: var(--mint); font-size: 0.85rem;"></i>
                <span class="chat-title-text">ROOM CHAT</span>
              </div>
              <div class="chat-live-badge">
                <span class="chat-live-dot"></span>
                <span>Live</span>
              </div>
            </div>

            <!-- Messages Stream -->
            <div class="chat-inline-messages" id="messagesList"></div>

            <!-- Typing indicator -->
            <div class="typing-indicator" id="typingIndicator"></div>

            <!-- Emoji reactions row -->
            <div class="chat-inline-emoji-bar">
              <button type="button" class="btn-emoji" data-emoji="❤️" title="Love">❤️</button>
              <button type="button" class="btn-emoji" data-emoji="🔥" title="Fire">🔥</button>
              <button type="button" class="btn-emoji" data-emoji="😂" title="Laugh">😂</button>
              <button type="button" class="btn-emoji" data-emoji="🍿" title="Popcorn">🍿</button>
              <button type="button" class="btn-emoji" data-emoji="👏" title="Clap">👏</button>
              <button type="button" class="btn-emoji" data-emoji="🚀" title="Rocket">🚀</button>
            </div>

            <!-- Chat input form -->
            <div class="chat-inline-input-wrapper">
              <input type="text" id="chatInput" class="clean-input-box chat-inline-input" placeholder="Send a message..." autocomplete="off">
              <button type="button" id="btnSendChat" class="btn-mint-pill chat-inline-send-btn" title="Send message">
                <i class="fa-solid fa-paper-plane"></i>
              </button>
            </div>
          </div>

        </div>

      </div>

      <!-- Floating Bottom Control Dock (Exact match of Virtual Huddle Image 1) -->
      <div class="huddle-bottom-dock-wrapper">
        
        <!-- Main Controls Dock Pill -->
        <div class="huddle-dock">
          <!-- Microphone Toggle Button -->
          <button class="dock-circle-btn" id="btnToggleMic" title="Mute/Unmute Mic">
            <i class="fa-solid fa-microphone"></i>
          </button>

          <!-- Camera Toggle Button -->
          <button class="dock-circle-btn" id="btnToggleCam" title="Turn Camera On/Off">
            <i class="fa-solid fa-video"></i>
          </button>

          <!-- Screen Share Button -->
          <button class="dock-circle-btn" id="btnShareScreen" title="Share Screen in Theater">
            <i class="fa-solid fa-arrow-up-from-bracket"></i>
          </button>

          <!-- Theater / Cinema Mode Toggle Button -->
          <button class="dock-circle-btn" id="btnDockCinemaToggle" title="Toggle Cinema View">
            <i class="fa-solid fa-tv" id="dockCinemaIcon"></i>
          </button>

          <!-- Resync / Options Button -->
          <button class="dock-circle-btn" id="btnResync" title="Force Resync">
            <i class="fa-solid fa-ellipsis"></i>
          </button>

          <!-- Play / Pause Button -->
          <button class="dock-circle-btn" id="btnPlayPause" title="Play/Pause">
            <i class="fa-solid fa-play" id="playIcon"></i>
          </button>

          <!-- Red End Call Button (from Virtual Huddle) -->
          <button class="dock-end-call-btn" id="btnLeaveRoom" title="Leave Call" onclick="window.location.href='/'">
            <i class="fa-solid fa-phone-slash"></i>
          </button>
        </div>

        <!-- Chat & Reactions Dock Pill (Bottom Right in Virtual Huddle) -->
        <div class="huddle-side-dock">
          <button class="dock-circle-btn" id="btnToggleChat" title="Focus Chat">
            <i class="fa-regular fa-message"></i>
          </button>
          <button class="dock-circle-btn" id="btnOpenReactions" title="Emoji Burst">
            <i class="fa-regular fa-face-smile"></i>
          </button>
        </div>

      </div>

      <!-- Timeline Scrubber Mini Dock (Floats over stage when scrubbing) -->
      <div style="position: absolute; bottom: 84px; left: 50%; transform: translateX(-50%); width: min(650px, 90vw); z-index: 90;">
        <div style="display: flex; align-items: center; gap: 10px; background: rgba(18, 20, 27, 0.85); backdrop-filter: blur(16px); padding: 6px 16px; border-radius: var(--radius-full); border: 1px solid var(--border-subtle);">
          <span class="time-readout" id="timeCurrent" style="font-size: 0.75rem; color: var(--text-dim); font-family: monospace;">00:00</span>
          
          <div class="timeline-progress-bar" id="timelineProgress" style="flex: 1; height: 5px; background: rgba(255, 255, 255, 0.1); border-radius: 3px; cursor: pointer; position: relative;">
            <div class="timeline-current" id="timelineCurrent" style="height: 100%; width: 0%; background: var(--mint); border-radius: 3px;"></div>
          </div>

          <span class="time-readout" id="timeDuration" style="font-size: 0.75rem; color: var(--text-dim); font-family: monospace;">00:00</span>
          
          <!-- Speed -->
          <select class="speed-select" id="speedSelect" style="background: transparent; border: none; color: white; font-size: 0.75rem; font-weight: 700; cursor: pointer; outline: none;">
            <option value="0.5">0.5x</option>
            <option value="1.0" selected>1.0x</option>
            <option value="1.25">1.25x</option>
            <option value="1.5">1.5x</option>
            <option value="2.0">2.0x</option>
          </select>
        </div>
      </div>

    </main>

  </div>

  <!-- Direct Video URL Modal -->
  <div class="modal-backdrop" id="videoModal">
    <div class="modal-dialog">
      <div class="modal-header">
        <h3 class="modal-title">Load Direct Video</h3>
        <button class="btn-close-drawer" id="btnCloseModal">✕</button>
      </div>

      <form id="formLoadVideo">
        <label class="input-label-clean" for="inputVideoUrl">Video URL (YouTube or Direct MP4 / Web Stream)</label>
        <input type="text" id="inputVideoUrl" class="clean-input-box" placeholder="https://www.youtube.com/watch?v=... or direct MP4 URL" required>

        <p style="font-size: 0.75rem; color: var(--text-dim); margin: 6px 0 16px;">
          Both participants will instantly switch to this video in lockstep synchronization.
        </p>

        <button type="submit" class="btn-mint-pill" style="width: 100%; padding: 12px;">
          <span>↗ Load & Sync with Partner</span>
        </button>
      </form>
    </div>
  </div>

  <!-- Share & Invite Friends Modal -->
  <div class="modal-backdrop" id="shareModal">
    <div class="modal-dialog" style="max-width: 480px;">
      <div class="modal-header">
        <h3 class="modal-title"><i class="fa-solid fa-user-plus" style="color: var(--primary); margin-right: 8px;"></i>Invite Friends</h3>
        <button class="btn-close-modal" id="btnCloseShareModal">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <div style="margin-top: 14px;">
        <label class="form-label" style="margin-bottom: 6px;">Shareable Room Link</label>
        <div style="display: flex; gap: 8px;">
          <input type="text" id="inputShareLink" class="form-input" readonly style="flex: 1; font-size: 0.82rem; background: rgba(0,0,0,0.3);">
          <button type="button" id="btnCopyShareModalLink" class="btn btn-primary" style="padding: 8px 16px;">
            <i class="fa-regular fa-copy"></i> Copy
          </button>
        </div>
      </div>

      <!-- WiFi / Local Network Link (for devices on the same network) -->
      <div id="wifiShareSection" style="margin-top: 14px; padding: 12px; border-radius: 8px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.08); display: none;">
        <div style="font-size: 0.8rem; font-weight: 700; color: var(--accent); margin-bottom: 4px;">
          <i class="fa-solid fa-wifi" style="margin-right: 6px;"></i>For friends on the same WiFi / Mobile Hotspot:
        </div>
        <div style="font-size: 0.74rem; color: var(--text-muted); margin-bottom: 8px;">
          Use this link so phones or other laptops can connect without "localhost" errors:
        </div>
        <div style="display: flex; gap: 8px;">
          <input type="text" id="inputWifiShareLink" class="form-input" readonly style="flex: 1; font-size: 0.78rem; background: rgba(0,0,0,0.3);">
          <button type="button" id="btnCopyWifiLink" class="btn btn-secondary" style="padding: 6px 12px; font-size: 0.8rem;">
            <i class="fa-regular fa-copy"></i> Copy
          </button>
        </div>
      </div>

      <!-- Room Code -->
      <div style="margin-top: 14px; display: flex; align-items: center; justify-content: space-between; padding: 12px; border-radius: 8px; background: rgba(0,0,0,0.25);">
        <div>
          <div style="font-size: 0.72rem; color: var(--text-dim); text-transform: uppercase;">Room Code</div>
          <div style="font-size: 1.1rem; font-weight: 800; color: #fff; letter-spacing: 1px;"><%= roomId %></div>
        </div>
        <button type="button" id="btnCopyCodeOnly" class="btn btn-secondary" style="padding: 6px 12px; font-size: 0.8rem;">
          <i class="fa-regular fa-clone"></i> Copy Code
        </button>
      </div>

      <!-- Native Share Button for mobile/macOS -->
      <button type="button" id="btnNativeShare" class="btn btn-primary" style="width: 100%; margin-top: 16px; display: none; padding: 12px;">
        <i class="fa-solid fa-arrow-up-from-bracket"></i> Share via WhatsApp / Messages...
      </button>
    </div>
  </div>

  <!-- Join Name Prompt Modal (When entering via direct invite link without a name) -->
  <div class="modal-backdrop" id="joinNameModal">
    <div class="modal-dialog" style="max-width: 420px; text-align: center;">
      <div style="width: 52px; height: 52px; border-radius: 50%; background: rgba(99,102,241,0.15); border: 1px solid rgba(99,102,241,0.3); display: flex; align-items: center; justify-content: center; margin: 0 auto 12px; font-size: 1.4rem; color: var(--primary);">
        <i class="fa-solid fa-clapperboard"></i>
      </div>
      <h3 style="font-size: 1.2rem; font-weight: 800; color: #fff; margin-bottom: 6px;">Join Watch Party</h3>
      <p style="font-size: 0.82rem; color: var(--text-muted); margin-bottom: 18px;">
        You're entering room <strong style="color: var(--accent);"><%= roomId %></strong>. What should we call you?
      </p>

      <form id="formJoinName">
        <div class="form-group" style="text-align: left; margin-bottom: 16px;">
          <label class="form-label" for="inputJoinName">Your Display Name</label>
          <div class="input-wrapper">
            <i class="fa-solid fa-user input-icon"></i>
            <input type="text" id="inputJoinName" class="form-input" placeholder="e.g. Alex" required autofocus>
          </div>
        </div>

        <button type="submit" class="btn btn-primary" style="width: 100%; padding: 12px; font-size: 0.95rem;">
          <i class="fa-solid fa-door-open"></i> Join Room Now
        </button>
      </form>
    </div>
  </div>

  <!-- Toast Notification -->
  <div class="toast-notice" id="toastNotice"></div>

  <!-- Runtime Config -->
  <script>
    window.ROOM_CONFIG = {
      roomId: "<%= roomId %>",
      userName: "<%= initialUserName %>",
      networkIp: "<%= typeof networkIp !== 'undefined' ? networkIp : 'localhost' %>",
      serverPort: "<%= typeof serverPort !== 'undefined' ? serverPort : '8080' %>"
    };
  </script>

  <!-- External Libraries -->
  <script src="https://www.youtube.com/iframe_api"></script>
  <script src="/socket.io/socket.io.js"></script>

  <!-- Watch Together Modular Engines -->
  <script src="/js/sync-engine.js"></script>
  <script src="/js/webrtc-call.js"></script>
  <script src="/js/chat-engine.js"></script>
  <script src="/js/room.js"></script>

  <script>
    // Focus inline chat when chat button clicked
    const btnToggleChat = document.getElementById('btnToggleChat');
    const chatInput = document.getElementById('chatInput');
    if (btnToggleChat && chatInput) {
      btnToggleChat.addEventListener('click', () => {
        chatInput.focus();
        chatInput.style.borderColor = 'var(--mint)';
        setTimeout(() => chatInput.style.borderColor = '', 1200);
      });
    }

    // Sidebar playback source buttons
    const btnSidebarDirectLink = document.getElementById('btnSidebarDirectLink');
    const videoModal = document.getElementById('videoModal');
    if (btnSidebarDirectLink && videoModal) {
      btnSidebarDirectLink.addEventListener('click', () => {
        videoModal.classList.add('open');
      });
    }

    const btnSidebarScreenShare = document.getElementById('btnSidebarScreenShare');
    if (btnSidebarScreenShare && window.webrtcCall) {
      btnSidebarScreenShare.addEventListener('click', () => {
        window.webrtcCall.toggleScreenShare();
      });
    }

    // Local File Picker Trigger
    const btnOpenLocalFile = document.getElementById('btnOpenLocalFile');
    const inputLocalFile = document.getElementById('inputLocalFile');
    if (btnOpenLocalFile && inputLocalFile) {
      btnOpenLocalFile.addEventListener('click', () => {
        inputLocalFile.click();
      });
    }

    // Copy Invite in Sidebar
    const btnCopyInviteSidebar = document.getElementById('btnCopyInviteSidebar');
    if (btnCopyInviteSidebar) {
      btnCopyInviteSidebar.addEventListener('click', () => {
        navigator.clipboard.writeText(window.location.href);
        const toast = document.getElementById('toastNotice');
        if (toast) {
          toast.textContent = "📋 Invite link copied to clipboard!";
          toast.classList.add('show');
          setTimeout(() => toast.classList.remove('show'), 2500);
        }
      });
    }
  </script>
</body>
</html>
